{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // DOM нужен e2e-тестам: колбэки page.evaluate выполняются в браузере.
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "vite.config.ts",
    "playwright.config.ts",
    "capacitor.config.ts",
    "eslint.config.js",
    "scripts",
    "tests/e2e"
  ]
}
